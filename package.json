    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "5.0.3"
  }
